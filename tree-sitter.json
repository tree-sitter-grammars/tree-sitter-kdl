{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "kdl",
      "camelcase": "KDL",
      "title": "KDL",
      "scope": "source.kdl",
      "path": ".",
      "file-types": [
        "kdl"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^kdl$",
      "class-name": "TreeSitterKDL"
    }
  ],
  "metadata": {
    "version": "1.1.0",
    "license": "MIT",
    "description": "KDL grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "contact@amaanq.com"
      }
    ],
    "links": {
      "repository": "https://github.com/amaanq/tree-sitter-kdl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
